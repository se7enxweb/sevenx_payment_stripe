  <changelog xmlns:ezchangelog="http://ez.no/ezpackage">
    <entry timestamp="1748131200"
           person="7x"
           email="info@se7enx.com"
           release="1.0.0">
      <change>Complete rewrite: Authorize.Net replaced by Stripe Payment Element (PaymentIntents API, Stripe.js v3).</change>
      <change>Added confirm.php: server-side PaymentIntent verification and order status update.</change>
      <change>Added Stripe Tax Calculations API integration (non-blocking).</change>
      <change>Added order ownership check in charge.php.</change>
      <change>Moved secret key to stripe.ini.append.php.</change>
      <change>Fixed PHP 8 deprecation in eZOrder::active() parameter order.</change>
      <change>Removed all Authorize.Net legacy code.</change>
    </entry>
    <entry timestamp="1101093193"
           person="Brookins Consulting"
           email="info@brookinsconsulting.com"
           release="1.0.0">
      <change>Initial release — Authorize.Net AIM gateway for eZ Publish.</change>
    </entry>
