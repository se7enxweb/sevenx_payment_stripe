{
    "name": "se7enxweb/sevenx_payment_stripe",
    "description": "Stripe Payment Element gateway for eZ Publish 4 / Exponential CMS. Integrates the Stripe PaymentIntents API and Stripe.js Payment Element into the eZ Publish shop workflow. Supports cards, Apple Pay, Google Pay, Link, Stripe Tax, and all Stripe-enabled payment methods.",
    "type": "ezpublish-legacy-extension",
    "keywords": [
        "eZ Publish",
        "eZ Publish Legacy",
        "Exponential CMS",
        "Stripe",
        "Payment Element",
        "PaymentIntents",
        "payment gateway",
        "credit cards",
        "Apple Pay",
        "Google Pay",
        "extension",
        "module"
    ],
    "homepage": "https://github.com/se7enxweb/sevenx_payment_stripe",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "7x",
            "homepage": "https://se7enx.com",
            "email": "info@se7enx.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.0.0",
        "stripe/stripe-php": "^14.0"
    },
    "minimum-stability": "stable",
    "extra": {
        "ezpublish-legacy-extension-name": "sevenx_payment_stripe"
    }
}
